<?xml version="1.0"?>
  <xacro:property name="density" value="2700"/>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="freecad_demo_arm">
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://freecad_demo_arm_description/meshes/base.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="base_link_material">
        <color rgba="0.8 0.8 0.82 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.01" rpy="0 0 0" />
      <geometry>
        <box size="0.12 0.12 0.02" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.01" rpy="0 0 0" />
      <mass value="0.7776" />
      <inertia ixx="0.00095904" ixy="0" ixz="0" iyy="0.00095904" iyz="0" izz="0.00186624" />
    </inertial>
  </link>
  <link name="arm1_link">
    <visual>
      <origin xyz="0 0 -0.02" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://freecad_demo_arm_description/meshes/arm1.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="arm1_link_material">
        <color rgba="0.2 0.45 0.8 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.075" rpy="0 0 0" />
      <geometry>
        <box size="0.02 0.02 0.15" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.075" rpy="0 0 0" />
      <mass value="0.162" />
      <inertia ixx="0.00030915" ixy="0" ixz="0" iyy="0.00030915" iyz="0" izz="1.08e-05" />
    </inertial>
  </link>
  <link name="arm2_link">
    <visual>
      <origin xyz="0 0 -0.17" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://freecad_demo_arm_description/meshes/arm2.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="arm2_link_material">
        <color rgba="0.9 0.55 0.15 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0" />
      <geometry>
        <box size="0.016 0.016 0.1" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.05" rpy="0 0 0" />
      <mass value="0.06912" />
      <inertia ixx="5.907456e-05" ixy="0" ixz="0" iyy="5.907456e-05" iyz="0" izz="2.94912e-06" />
    </inertial>
  </link>
  <joint name="shoulder_joint" type="revolute">
    <parent link="base_link" />
    <child link="arm1_link" />
    <origin xyz="0 0 0.02" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit effort="10" velocity="2" lower="-1.57" upper="1.57" />
  </joint>
  <joint name="elbow_joint" type="revolute">
    <parent link="arm1_link" />
    <child link="arm2_link" />
    <origin xyz="0 0 0.15" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit effort="10" velocity="2" lower="-1.57" upper="1.57" />
  </joint>
</robot>
