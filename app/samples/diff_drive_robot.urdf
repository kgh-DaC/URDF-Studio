    <inertial>
      <origin xyz="0 0 0.08" rpy="0 0 0" />
      <mass value="5" />
      <inertia ixx="0.0416666667" ixy="0" ixz="0" iyy="0.0708333333" iyz="0" izz="0.104166667" />
    </inertial>
  </link>
