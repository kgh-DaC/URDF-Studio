      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963 0 0" />
      <geometry>
        <cylinder radius="0.06" length="0.03" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="1.5707963 0 0" />
      <mass value="0.4" />
      <inertia ixx="0.00039" ixy="0" ixz="0" iyy="0.00039" iyz="0" izz="0.00072" />
    </inertial>
