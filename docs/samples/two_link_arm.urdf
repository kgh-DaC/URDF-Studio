<?xml version="1.0"?>
<robot name="two_link_arm">
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.025" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.08" length="0.05" />
      </geometry>
      <material name="base_link_material">
        <color rgba="0.3 0.3 0.33 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.025" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.08" length="0.05" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.025" rpy="0 0 0" />
      <mass value="2" />
      <inertia ixx="0.00361666667" ixy="0" ixz="0" iyy="0.00361666667" iyz="0" izz="0.0064" />
    </inertial>
  </link>
  <link name="shoulder_link">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.04" length="0.1" />
      </geometry>
      <material name="shoulder_link_material">
        <color rgba="0.2 0.45 0.8 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.04" length="0.1" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.05" rpy="0 0 0" />
      <mass value="0.6" />
      <inertia ixx="0.00074" ixy="0" ixz="0" iyy="0.00074" iyz="0" izz="0.00048" />
    </inertial>
  </link>
  <link name="upper_arm_link">
    <visual>
      <origin xyz="0 0 0.15" rpy="0 0 0" />
      <geometry>
        <box size="0.05 0.05 0.3" />
      </geometry>
      <material name="upper_arm_link_material">
        <color rgba="0.9 0.55 0.15 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.15" rpy="0 0 0" />
      <geometry>
        <box size="0.05 0.05 0.3" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.15" rpy="0 0 0" />
      <mass value="0.8" />
      <inertia ixx="0.00616666667" ixy="0" ixz="0" iyy="0.00616666667" iyz="0" izz="0.000333333333" />
    </inertial>
  </link>
  <link name="forearm_link">
    <visual>
      <origin xyz="0 0 0.125" rpy="0 0 0" />
      <geometry>
        <box size="0.04 0.04 0.25" />
      </geometry>
      <material name="forearm_link_material">
        <color rgba="0.25 0.65 0.35 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.125" rpy="0 0 0" />
      <geometry>
        <box size="0.04 0.04 0.25" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.125" rpy="0 0 0" />
      <mass value="0.5" />
      <inertia ixx="0.00267083333" ixy="0" ixz="0" iyy="0.00267083333" iyz="0" izz="0.000133333333" />
    </inertial>
  </link>
  <link name="tool_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.03" />
      </geometry>
      <material name="tool_link_material">
        <color rgba="0.85 0.25 0.25 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.03" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.1" />
      <inertia ixx="3.6e-05" ixy="0" ixz="0" iyy="3.6e-05" iyz="0" izz="3.6e-05" />
    </inertial>
  </link>
  <joint name="shoulder_pan_joint" type="revolute">
    <parent link="base_link" />
    <child link="shoulder_link" />
    <origin xyz="0 0 0.05" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit effort="20" velocity="2" lower="-3.14159" upper="3.14159" />
  </joint>
  <joint name="shoulder_lift_joint" type="revolute">
    <parent link="shoulder_link" />
    <child link="upper_arm_link" />
    <origin xyz="0 0 0.1" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit effort="20" velocity="2" lower="-1.57" upper="1.57" />
  </joint>
  <joint name="elbow_joint" type="revolute">
    <parent link="upper_arm_link" />
    <child link="forearm_link" />
    <origin xyz="0 0 0.3" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit effort="10" velocity="2.5" lower="-2.5" upper="2.5" />
  </joint>
  <joint name="forearm_to_tool_joint" type="fixed">
    <parent link="forearm_link" />
    <child link="tool_link" />
    <origin xyz="0 0 0.25" rpy="0 0 0" />
  </joint>
</robot>
